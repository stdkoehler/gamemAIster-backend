{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/DesolateFrontierCharacter",
  "definitions": {
    "DesolateFrontierCharacter": {
      "type": "object",
      "properties": {
        "gameType": {
          "type": "string",
          "const": "desolate_frontier"
        },
        "id": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        },
        "originAbility": {
          "type": "string"
        },
        "profession": {
          "type": "string"
        },
        "age": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "properties": {
            "Strength": {
              "type": "number"
            },
            "Agility": {
              "type": "number"
            },
            "Wits": {
              "type": "number"
            },
            "Empathy": {
              "type": "number"
            }
          },
          "required": [
            "Strength",
            "Agility",
            "Wits",
            "Empathy"
          ],
          "additionalProperties": false
        },
        "attributeDamage": {
          "type": "object",
          "properties": {
            "Strength": {
              "type": "number"
            },
            "Agility": {
              "type": "number"
            },
            "Wits": {
              "type": "number"
            },
            "Empathy": {
              "type": "number"
            }
          },
          "required": [
            "Strength",
            "Agility",
            "Wits",
            "Empathy"
          ],
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "Melee": {
              "type": "number"
            },
            "Endurance": {
              "type": "number"
            },
            "Labor": {
              "type": "number"
            },
            "Intimidation": {
              "type": "number"
            },
            "Shooting": {
              "type": "number"
            },
            "Riding": {
              "type": "number"
            },
            "Sleight of Hand": {
              "type": "number"
            },
            "Move": {
              "type": "number"
            },
            "Tracking": {
              "type": "number"
            },
            "Survival": {
              "type": "number"
            },
            "Gambling": {
              "type": "number"
            },
            "Repair": {
              "type": "number"
            },
            "Persuasion": {
              "type": "number"
            },
            "Leadership": {
              "type": "number"
            },
            "Animal Handling": {
              "type": "number"
            },
            "Healing": {
              "type": "number"
            }
          },
          "required": [
            "Melee",
            "Endurance",
            "Labor",
            "Intimidation",
            "Shooting",
            "Riding",
            "Sleight of Hand",
            "Move",
            "Tracking",
            "Survival",
            "Gambling",
            "Repair",
            "Persuasion",
            "Leadership",
            "Animal Handling",
            "Healing"
          ],
          "additionalProperties": false
        },
        "talents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pride": {
          "type": "string"
        },
        "darkSecret": {
          "type": "string"
        },
        "willpower": {
          "$ref": "#/definitions/StatTrack"
        },
        "reputation": {
          "$ref": "#/definitions/DesolateFrontierReputation"
        },
        "bounty": {
          "$ref": "#/definitions/DesolateFrontierBounty"
        },
        "weapons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DesolateFrontierWeapon"
          }
        },
        "armor": {
          "$ref": "#/definitions/DesolateFrontierArmor"
        },
        "gear": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cash": {
          "type": "number"
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "experience": {
          "type": "number"
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "gameType",
        "id",
        "name",
        "origin",
        "originAbility",
        "profession",
        "description",
        "attributes",
        "attributeDamage",
        "skills",
        "talents"
      ],
      "additionalProperties": false
    },
    "StatTrack": {
      "type": "object",
      "properties": {
        "current": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "current",
        "max"
      ],
      "additionalProperties": false
    },
    "DesolateFrontierReputation": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "DesolateFrontierBounty": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number"
        },
        "level": {
          "type": "string",
          "enum": [
            "Minor",
            "Moderate",
            "Major",
            "Legendary"
          ]
        }
      },
      "required": [
        "amount",
        "level"
      ],
      "additionalProperties": false
    },
    "DesolateFrontierWeapon": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "grip": {
          "type": "string",
          "enum": [
            "1H",
            "2H"
          ]
        },
        "damage": {
          "type": "number"
        },
        "range": {
          "type": "string",
          "enum": [
            "Arm's Length",
            "Near",
            "Short",
            "Long"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "grip",
        "damage",
        "range"
      ],
      "additionalProperties": false
    },
    "DesolateFrontierArmor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rating": {
          "$ref": "#/definitions/StatTrack"
        }
      },
      "required": [
        "name",
        "rating"
      ],
      "additionalProperties": false
    }
  }
}
