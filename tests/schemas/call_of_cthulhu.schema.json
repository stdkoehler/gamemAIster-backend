          "items": {
            "type": "string"
          }
        },
        "fellowsAndContacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "significantPeople": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meaningfulLocations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "treasuredPossessions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weapons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CocWeapon"
          }
        },
        "armor": {
          "$ref": "#/definitions/ArmorItem"
        },
        "gear": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "spendingLevel": {
          "type": "string"
        },
        "cash": {
          "type": "number"
        },
        "assets": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
