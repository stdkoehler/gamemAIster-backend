        "skill": {
          "type": "string"
        },
        "damage": {
          "type": "string"
        },
        "range": {
          "type": "string"
        },
        "attacksPerRound": {
          "type": "number"
        },
        "ammo": {
          "type": "number"
        },
        "malfunction": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "skill",
        "damage"
      ],
      "additionalProperties": false
    },
    "ArmorItem": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        }
      },
      "required": [
        "name",
        "rating"
      ],
      "additionalProperties": false
    }
  }
}
