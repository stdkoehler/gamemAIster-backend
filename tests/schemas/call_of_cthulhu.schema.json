      "required": [
        "gameType",
        "id",
        "name",
        "occupation",
        "era",
        "age",
        "description",
        "characteristics",
        "derived",
        "skills",
        "hitPoints",
        "sanity",
        "magicPoints",
        "luck",
        "cthulhuMythos"
      ],
      "additionalProperties": false
    },
    "StatTrack": {
      "type": "object",
      "properties": {
        "current": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      },
      "required": [
        "current",
        "max"
      ],
      "additionalProperties": false
    },
    "CocWeapon": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
